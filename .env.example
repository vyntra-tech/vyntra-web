# Backend Environment Configuration
PORT=5000
MONGODB_URI=your_mongodb_connection_string
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_jwt_secret

# Optional Mail Configuration (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
CONTACT_FROM=

# Frontend Environment Variables (Vite)
# When served on the same origin (Express serving dist), leave as /api
# If frontend is hosted on separate domain/port, set to your backend URL e.g. http://<ec2-ip>:5000/api
VITE_API_URL=/api
VITE_BASE_PATH=/




